SELECT *, ROW_NUMBER() OVER(partition by card_type ORDER BY credit_Score desc) AS RowNumber
FROM creditScore

SELECT *, rank() OVER(partition by card_type ORDER BY credit_Score desc) AS RankNumber
FROM creditScore

SELECT *, dense_rank() OVER(partition by card_type ORDER BY credit_Score desc) AS DenseRankNumber
FROM creditScore

